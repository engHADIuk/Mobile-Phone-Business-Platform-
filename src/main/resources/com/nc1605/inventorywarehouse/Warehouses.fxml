<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?><?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.nc1605.inventorywarehouse.controller.WarehouseController"><left><VBox spacing="10" styleClass="sidebar"><Label text="VELMORA" styleClass="brand"/><Label text="INVENTORY" styleClass="subtitle"/><VBox prefHeight="28"/><Button text="◈  Dashboard" onAction="#dashboard"/><Button text="▣  Warehouses" onAction="#warehouses"/><Button text="□  Inventory" onAction="#inventory"/><Button text="▦  Products" onAction="#products"/><Button text="↔  Transfers" onAction="#transfers"/><Button text="▥  Reports" onAction="#reports"/></VBox></left><center><VBox spacing="16" styleClass="content"><Button fx:id="backButton" text="← Back to Dashboard" onAction="#backToSource" styleClass="back-button"/><HBox alignment="CENTER_LEFT"><VBox spacing="8" HBox.hgrow="ALWAYS"><Label text="Warehouses" styleClass="page-title"/><Label text="Manage locations, capacity and the stock held at each site." styleClass="subtitle"/></VBox><Button text="+ Add warehouse" onAction="#newWarehouse"/></HBox><GridPane fx:id="warehouseForm" hgap="12" vgap="12" styleClass="alert-panel"><Label fx:id="formTitle" text="Add warehouse" styleClass="section-title" GridPane.columnSpan="2"/><Label text="Warehouse name" GridPane.rowIndex="1"/><TextField fx:id="nameField" promptText="e.g. Manchester North" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Location" GridPane.rowIndex="2"/><TextField fx:id="locationField" promptText="e.g. Manchester" GridPane.columnIndex="1" GridPane.rowIndex="2"/><Label text="Capacity" GridPane.rowIndex="3"/><TextField fx:id="capacityField" promptText="Maximum stock units" GridPane.columnIndex="1" GridPane.rowIndex="3"/><HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4"><Button fx:id="saveButton" text="Save warehouse" onAction="#saveWarehouse"/><Button text="Cancel" onAction="#cancelEdit" styleClass="secondary-button"/></HBox><Label fx:id="messageLabel" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5"/></GridPane><Label text="Active locations" styleClass="section-title"/><ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;"><content><FlowPane fx:id="warehouseCards" hgap="18" vgap="18" prefWrapLength="800"/></content></ScrollPane></VBox></center></BorderPane>
