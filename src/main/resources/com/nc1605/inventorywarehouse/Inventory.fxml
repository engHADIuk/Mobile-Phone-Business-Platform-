<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.nc1605.inventorywarehouse.controller.InventoryController"><left><VBox spacing="10" styleClass="sidebar"><Label text="VELMORA" styleClass="brand"/><Label text="INVENTORY" styleClass="subtitle"/><VBox prefHeight="28"/><Button text="◈  Dashboard" onAction="#dashboard"/><Button text="▣  Warehouses" onAction="#warehouses"/><Button text="□  Inventory" onAction="#inventory"/><Button text="▦  Products" onAction="#products"/><Button text="↔  Transfers" onAction="#transfers"/><Button text="▥  Reports" onAction="#reports"/></VBox></left><center><VBox spacing="18" styleClass="content"><HBox fx:id="warehouseFilterBar" alignment="CENTER_LEFT" spacing="10"><Button fx:id="backButton" text="← Back" onAction="#backToSource" styleClass="back-button"/><Label fx:id="warehouseFilterLabel" styleClass="filter-chip"/><Button fx:id="clearFilterButton" text="Clear filter" onAction="#clearWarehouseFilter" styleClass="small-button"/></HBox><Label text="Inventory" styleClass="page-title"/><Label text="Track and manage product stock levels" styleClass="subtitle"/><HBox spacing="12"><TextField fx:id="searchField" promptText="Search products..." onKeyReleased="#refresh"/><ComboBox fx:id="statusBox" onAction="#refresh"/><Button text="Refresh" onAction="#refresh"/></HBox><TableView fx:id="inventoryTable"/></VBox></center></BorderPane>
