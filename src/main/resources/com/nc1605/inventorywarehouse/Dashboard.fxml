<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?><?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.nc1605.inventorywarehouse.controller.DashboardController">
 <left><VBox spacing="10" styleClass="sidebar"><Label text="VELMORA" styleClass="brand"/><Label text="INVENTORY" styleClass="subtitle"/><VBox prefHeight="28"/><Button text="◈  Dashboard" onAction="#dashboard"/><Button text="▣  Warehouses" onAction="#warehouses"/><Button text="□  Inventory" onAction="#inventory"/><Button text="▦  Products" onAction="#products"/><Button text="↔  Transfers" onAction="#transfers"/><Button text="▥  Reports" onAction="#reports"/></VBox></left>
 <center><VBox spacing="22" styleClass="content"><Label text="Inventory System" styleClass="page-title"/><Label text="Welcome back. Here's your inventory overview." styleClass="subtitle"/><HBox spacing="16"><VBox styleClass="metric" onMouseClicked="#showAllInventory"><Label text="Total stock units"/><Label fx:id="totalUnitsLabel" styleClass="metric-number"/><Label text="View all inventory →" styleClass="hint"/></VBox><VBox styleClass="metric" onMouseClicked="#showLowStock"><Label text="Low stock alerts"/><Label fx:id="lowStockLabel" styleClass="metric-number warning"/><Label text="Open low-stock list →" styleClass="hint"/></VBox><VBox styleClass="metric" onMouseClicked="#showCriticalStock"><Label text="Critical lines"/><Label fx:id="criticalLabel" styleClass="metric-number danger"/><Label text="Needs attention →" styleClass="hint"/></VBox><VBox styleClass="metric" onMouseClicked="#openWarehouses"><Label text="Warehouses"/><Label fx:id="warehouseLabel" styleClass="metric-number"/><Label text="Open locations →" styleClass="hint"/></VBox></HBox><VBox spacing="10" styleClass="alert-panel"><Label text="Stock alerts" styleClass="section-title"/><Label text="Select an alert to open the matching filtered inventory list." styleClass="subtitle"/><ListView fx:id="alertsList" prefHeight="180" onMouseClicked="#openSelectedAlert"/></VBox><Label text="Tip: use Transfers to move stock between locations; all screens update from the same database." styleClass="hint"/></VBox></center>
</BorderPane>
