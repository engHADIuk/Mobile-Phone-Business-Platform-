<?import javafx.scene.layout.*?><?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.nc1605.inventorywarehouse.controller.TransferController"><left><VBox spacing="10" styleClass="sidebar"><Label text="VELMORA" styleClass="brand"/><Label text="INVENTORY" styleClass="subtitle"/><VBox prefHeight="28"/><Button text="◈  Dashboard" onAction="#dashboard"/><Button text="▣  Warehouses" onAction="#warehouses"/><Button text="□  Inventory" onAction="#inventory"/><Button text="▦  Products" onAction="#products"/><Button text="↔  Transfers" onAction="#transfers"/><Button text="▥  Reports" onAction="#reports"/></VBox></left><center><VBox spacing="16" styleClass="content"><Label text="Stock Transfer" styleClass="page-title"/><Label text="Move inventory between warehouse locations. The system checks source stock and destination capacity." styleClass="subtitle" wrapText="true"/><GridPane hgap="12" vgap="14" styleClass="alert-panel"><Label text="Product at source" GridPane.rowIndex="0"/><ComboBox fx:id="itemBox" prefWidth="380" GridPane.columnIndex="1" GridPane.rowIndex="0"/><Label text="To warehouse" GridPane.rowIndex="1"/><ComboBox fx:id="destinationBox" prefWidth="380" GridPane.columnIndex="1" GridPane.rowIndex="1"/><Label text="Quantity" GridPane.rowIndex="2"/><TextField fx:id="quantityField" promptText="Enter quantity" GridPane.columnIndex="1" GridPane.rowIndex="2"/><Button text="Create transfer  →" onAction="#submit" GridPane.columnIndex="1" GridPane.rowIndex="3"/></GridPane><Label fx:id="messageLabel" wrapText="true"/><Label text="Transfer history" styleClass="section-title"/><TableView fx:id="transferTable"/></VBox></center></BorderPane>
