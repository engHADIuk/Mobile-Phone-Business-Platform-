<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Ecommerce.Products.CustomerController"
            styleClass="root-bg">

    <top>
        <VBox styleClass="admin-header">
            <HBox alignment="CENTER" spacing="12">
                <padding><Insets top="20" right="24" bottom="12" left="24"/></padding>

                <HBox styleClass="header-side-box" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER" spacing="2">
                    <Label text="VELMORA" styleClass="brand-title-sm"/>
                    <StackPane styleClass="brand-underline" prefWidth="80"/>
                </VBox>

                <HBox styleClass="header-side-box" alignment="CENTER_RIGHT" spacing="8" HBox.hgrow="ALWAYS">
                    <StackPane>
                        <Button fx:id="favouritesButton" text="♡" styleClass="icon-button" onAction="#handleOpenFavourites"/>
                        <Label fx:id="favouritesBadge" styleClass="badge-counter" text="0" visible="false"/>
                    </StackPane>

                    <StackPane>
                        <Button fx:id="cartButton" text="🛒" styleClass="icon-button" onAction="#handleOpenBasket"/>
                        <Label fx:id="cartBadge" styleClass="badge-counter" text="0" visible="false"/>
                    </StackPane>

                    <Button text="Logout" styleClass="icon-button" onAction="#handleLogout"/>
                </HBox>
            </HBox>

            <VBox spacing="8" styleClass="toolbar-row">
                <padding><Insets top="4" right="24" bottom="14" left="24"/></padding>
                <TextField fx:id="searchField" promptText="Search phones..." styleClass="search-input"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Filters:" styleClass="subtitle-muted"/>
                    <ComboBox fx:id="categoryFilter" promptText="All Categories" styleClass="filter-combo"/>
                    <ComboBox fx:id="priceFilter" promptText="All Prices" styleClass="filter-combo"/>
                    <ComboBox fx:id="availabilityFilter" promptText="All Availability" styleClass="filter-combo"/>
                    <Button text="Reset" styleClass="secondary-button" onAction="#handleReset"/>
                    <Label fx:id="resultCountLabel" styleClass="subtitle-muted"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="grid-scroll">
            <FlowPane fx:id="productGrid" hgap="24" vgap="26" styleClass="product-grid">
                <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>
            </FlowPane>
        </ScrollPane>
    </center>
</BorderPane>