<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Ecommerce.Products.ProductFormController"
      styleClass="root-bg form-container" spacing="14" prefWidth="620">

    <padding><Insets top="28" right="32" bottom="24" left="32"/></padding>

    <Label fx:id="formTitle" text="Add New Product" styleClass="form-title"/>

    <GridPane hgap="20" vgap="4">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <Label text="Product ID *" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label text="Name *" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <TextField fx:id="idField" promptText="P001" styleClass="text-input" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="Velmora X Pro" styleClass="text-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Categories *" styleClass="field-label">
        <VBox.margin><Insets top="8"/></VBox.margin>
    </Label>
    <HBox spacing="20">
        <CheckBox fx:id="cbCompact" text="Compact" styleClass="category-check"/>
        <CheckBox fx:id="cbFoldable" text="Foldable" styleClass="category-check"/>
        <CheckBox fx:id="cbGaming" text="Gaming" styleClass="category-check"/>
        <CheckBox fx:id="cbFlips" text="Flips" styleClass="category-check"/>
    </HBox>

    <Label text="Description *" styleClass="field-label">
        <VBox.margin><Insets top="8"/></VBox.margin>
    </Label>
    <TextArea fx:id="descriptionField" promptText="Product description with colors and storage options..." styleClass="text-area-input" prefRowCount="3" wrapText="true"/>

    <GridPane hgap="20" vgap="4">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <Label text="Price (£) *" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label text="Stock *" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Spinner fx:id="priceSpinner" editable="true" styleClass="text-input" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="stockSpinner" editable="true" styleClass="text-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Main Image URL *" styleClass="field-label">
        <VBox.margin><Insets top="8"/></VBox.margin>
    </Label>
    <TextField fx:id="imageUrlField" promptText="https://..." styleClass="text-input"/>

    <Label text="Status" styleClass="field-label">
        <VBox.margin><Insets top="8"/></VBox.margin>
    </Label>
    <ComboBox fx:id="statusCombo" styleClass="filter-combo"/>

    <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false">
        <VBox.margin><Insets top="6"/></VBox.margin>
    </Label>

    <HBox alignment="CENTER_RIGHT" spacing="16">
        <VBox.margin><Insets top="18"/></VBox.margin>
        <Label text="Cancel" styleClass="switch-link" onMouseClicked="#handleCancel"/>
        <Button fx:id="saveButton" text="Add Product" styleClass="primary-button" onAction="#handleSave"/>
    </HBox>
</VBox>