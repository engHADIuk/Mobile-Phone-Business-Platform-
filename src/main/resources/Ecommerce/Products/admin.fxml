<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Ecommerce.Products.AdminController"
            styleClass="root-bg">

    <top>
        <VBox styleClass="admin-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>
                <VBox>
                    <Label text="VELMORA" styleClass="brand-title-sm"/>
                    <Label text="Admin Control Panel" styleClass="subtitle-muted"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="Logout" styleClass="logout-button" onAction="#handleLogout"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="toolbar-row">
                <padding><Insets top="10" right="24" bottom="14" left="24"/></padding>
                <TextField fx:id="searchField" promptText="Search by name or ID..." styleClass="search-input" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="categoryFilter" promptText="All Categories" styleClass="filter-combo"/>
                <ComboBox fx:id="statusFilter" promptText="All" styleClass="filter-combo"/>
                <Button text="Search" styleClass="secondary-button" onAction="#handleSearch"/>
                <Button text="Reset" styleClass="secondary-button" onAction="#handleReset"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="+ Add New Product" styleClass="primary-button" onAction="#handleAddProduct"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox styleClass="table-wrapper">
            <padding><Insets top="0" right="24" bottom="24" left="24"/></padding>

            <TableView fx:id="productTable" styleClass="product-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colImage" text="Image" prefWidth="70"/>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colName" text="Name" prefWidth="180"/>
                    <TableColumn fx:id="colCategories" text="Category" prefWidth="150"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="90"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                </columns>
            </TableView>

            <Label fx:id="emptyStateLabel" text="No products found." styleClass="empty-state" visible="false" managed="false"/>
        </VBox>
    </center>
</BorderPane>