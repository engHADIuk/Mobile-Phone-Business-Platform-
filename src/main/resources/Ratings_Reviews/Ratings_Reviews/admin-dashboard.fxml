<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Ratings_Reviews.Ratings_Reviews.AdminDashboardController" styleClass="app-background">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="top-bar">
            <padding><Insets bottom="18" left="30" right="30" top="18" /></padding>
            <Label text="VALMORA" styleClass="brand small-brand" />
            <Label text="Administration" styleClass="top-title" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button text="Log out" onAction="#logout" styleClass="secondary-button" />
        </HBox>
    </top>
    <center>
        <VBox spacing="12" styleClass="wide-content">
            <padding><Insets bottom="25" left="35" right="35" top="25" /></padding>
            <Label fx:id="welcomeLabel" styleClass="screen-title" />
            <Label text="Manage reviews and ratings for VALMORA products" styleClass="muted-text" />
            <Label text="Review overview" styleClass="section-heading" />
            <Label fx:id="statisticsLabel" styleClass="metric-panel" wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Future review edit window:" styleClass="field-label" />
                <TextField fx:id="editWindowField" prefWidth="65" />
                <Label text="minutes" styleClass="muted-text" />
                <Button text="Save setting" onAction="#saveEditWindow" styleClass="secondary-button" />
            </HBox>
            <HBox spacing="10">
                <ComboBox fx:id="productBox" onAction="#refresh" prefWidth="300" />
                <Button text="Refresh" onAction="#refresh" styleClass="secondary-button" />
                <Label fx:id="productSummaryLabel" styleClass="rating-summary" />
            </HBox>
            <ListView fx:id="reviewsList" prefHeight="270" VBox.vgrow="ALWAYS" />
            <HBox spacing="10">
                <TextField fx:id="reasonField" promptText="Optional moderation reason" HBox.hgrow="ALWAYS" />
                <Button text="Flag" onAction="#flagSelected" styleClass="secondary-button" />
                <Button text="Dismiss flag" onAction="#dismissFlag" styleClass="secondary-button" />
                <Button text="Remove" onAction="#removeSelected" styleClass="danger-button" />
                <Button text="Edit" onAction="#editSelected" styleClass="primary-button" />
            </HBox>
            <Label fx:id="actionLabel" styleClass="message-label" wrapText="true" />
        </VBox>
    </center>
</BorderPane>
