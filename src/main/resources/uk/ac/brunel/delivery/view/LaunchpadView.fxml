<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="uk.ac.brunel.delivery.controller.LaunchpadController"
           style="-fx-background-color: linear-gradient(to bottom right, #080909, #111313);">
    <children>
        <VBox maxWidth="1040" maxHeight="620" alignment="CENTER" spacing="26"
              style="-fx-background-color: #0C0D0D; -fx-background-radius: 20; -fx-border-color: #242626; -fx-border-radius: 20;">
            <padding><Insets top="55" right="72" bottom="55" left="72"/></padding>
            <children>
                <HBox spacing="13" alignment="CENTER">
                    <children>
                        <StackPane minWidth="48" minHeight="48" maxWidth="48" maxHeight="48"
                                   style="-fx-background-color: #D5C38B; -fx-background-radius: 10;">
                            <children>
                                <Label text="V" style="-fx-text-fill: #151515; -fx-font-weight: bold; -fx-font-size: 20;"/>
                            </children>
                        </StackPane>
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <children>
                                <Label text="VELMORA" style="-fx-text-fill: #F1F1EF; -fx-font-weight: bold; -fx-font-size: 24;"/>
                                <Label text="L U X U R Y   T E C H" style="-fx-text-fill: #797C7B; -fx-font-size: 8;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Region prefHeight="10"/>

                <Label text="WELCOME TO VELMORA"
                       style="-fx-text-fill: #D5C38B; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <Label text="E-COMMERCE
MANAGEMENT SYSTEM" textAlignment="CENTER" alignment="CENTER"
                       style="-fx-text-fill: #F1F1EF; -fx-font-weight: bold; -fx-font-size: 48; -fx-line-spacing: -5;">
                    <font><Font name="Arial Black" size="48"/></font>
                </Label>
                <Label text="Choose a component to enter the Velmora system."
                       style="-fx-text-fill: #797C7B; -fx-font-size: 13;"/>

                <Region prefHeight="12"/>

                <VBox maxWidth="590" spacing="15" alignment="CENTER_LEFT"
                      style="-fx-background-color: #141515; -fx-background-radius: 14; -fx-border-color: #292B2B; -fx-border-radius: 14; -fx-padding: 26 30;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <children>
                                <StackPane minWidth="52" minHeight="52" maxWidth="52" maxHeight="52"
                                           style="-fx-background-color: #D5C38B20; -fx-border-color: #D5C38B55; -fx-border-radius: 10; -fx-background-radius: 10;">
                                    <children>
                                        <Label text="DL" style="-fx-text-fill: #D5C38B; -fx-font-size: 15; -fx-font-weight: bold;"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="5">
                                    <children>
                                        <Label text="DELIVERY &amp; LOGISTICS" style="-fx-text-fill: #F1F1EF; -fx-font-size: 18; -fx-font-weight: bold;"/>
                                        <Label text="Driver assignments · Scheduling · Live delivery tracking · Audit history"
                                               wrapText="true" style="-fx-text-fill: #797C7B; -fx-font-size: 11;"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Button fx:id="launchButton" text="Open Delivery &amp; Logistics" onAction="#openDeliveryLogistics"
                                maxWidth="Infinity" prefHeight="46"/>
                    </children>
                </VBox>

                <Region prefHeight="4"/>
                <HBox spacing="32" alignment="CENTER">
                    <children>
                        <Label text="JAVAFX" style="-fx-text-fill: #676A69; -fx-font-size: 9; -fx-font-weight: bold;"/>
                        <Label text="MAVEN" style="-fx-text-fill: #676A69; -fx-font-size: 9; -fx-font-weight: bold;"/>
                        <Label text="SQLITE" style="-fx-text-fill: #676A69; -fx-font-size: 9; -fx-font-weight: bold;"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
