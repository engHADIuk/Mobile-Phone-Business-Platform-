<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="uk.ac.brunel.delivery.controller.LoginController"
           style="-fx-background-color: linear-gradient(to bottom right, #080909, #111313);">
    <children>
        <HBox maxWidth="1080" maxHeight="650" spacing="60" alignment="CENTER"
              style="-fx-background-color: #0C0D0D; -fx-background-radius: 18; -fx-border-color: #242626; -fx-border-radius: 18;">
            <padding><Insets top="58" right="68" bottom="58" left="68"/></padding>
            <children>
                <VBox spacing="20" prefWidth="500" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="launchpadButton" text="&#8592;  Launchpad" onAction="#backToLaunchpad"
                                visible="false" managed="false" prefHeight="30"/>
                        <HBox spacing="13" alignment="CENTER_LEFT">
                            <children>
                                <StackPane minWidth="42" minHeight="42" maxWidth="42" maxHeight="42"
                                           style="-fx-background-color: #D5C38B; -fx-background-radius: 9;">
                                    <children><Label text="V" style="-fx-text-fill: #151515; -fx-font-weight: bold; -fx-font-size: 17;"/></children>
                                </StackPane>
                                <VBox spacing="3">
                                    <children>
                                        <Label text="VELMORA" style="-fx-text-fill: #F1F1EF; -fx-font-weight: bold; -fx-font-size: 20;"/>
                                        <Label text="L U X U R Y   T E C H" style="-fx-text-fill: #797C7B; -fx-font-size: 8;"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <Region prefHeight="28"/>
                        <Label text="DELIVERY &amp;&#10;LOGISTICS" style="-fx-text-fill: #F1F1EF; -fx-font-weight: bold; -fx-font-size: 58; -fx-line-spacing: -8;">
                            <font><Font name="Arial Black" size="58"/></font>
                        </Label>
                        <Label text="Manage driver assignments, monitor live delivery status, and review the complete logistics audit trail."
                               wrapText="true" maxWidth="430" style="-fx-text-fill: #797C7B; -fx-font-size: 13; -fx-line-spacing: 5;"/>
                        <HBox spacing="26" style="-fx-padding: 18 0 0 0;">
                            <children>
                                <VBox spacing="4"><children><Label text="LIVE" style="-fx-text-fill: #3BD5A0; -fx-font-size: 22; -fx-font-weight: bold;"/><Label text="STATUS UPDATES" style="-fx-text-fill: #676A69; -fx-font-size: 9;"/></children></VBox>
                                <VBox spacing="4"><children><Label text="SQLITE" style="-fx-text-fill: #D5C38B; -fx-font-size: 22; -fx-font-weight: bold;"/><Label text="AUDIT STORAGE" style="-fx-text-fill: #676A69; -fx-font-size: 9;"/></children></VBox>
                                <VBox spacing="4"><children><Label text="SAFE" style="-fx-text-fill: #4CB7F6; -fx-font-size: 22; -fx-font-weight: bold;"/><Label text="SCHEDULING" style="-fx-text-fill: #676A69; -fx-font-size: 9;"/></children></VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="470" style="-fx-background-color: #242626;"/>
                <VBox spacing="15" prefWidth="330" alignment="CENTER_LEFT"
                      style="-fx-background-color: #141515; -fx-background-radius: 14; -fx-border-color: #292B2B; -fx-border-radius: 14; -fx-padding: 32;">
                    <children>
                        <Label text="Sign in" style="-fx-text-fill: #F1F1EF; -fx-font-size: 26; -fx-font-weight: bold;"/>
                        <Label text="Administrator, logistics manager, or driver"
                               style="-fx-text-fill: #797C7B; -fx-font-size: 11;"/>
                        <Region prefHeight="8"/>
                        <Label text="USERNAME" style="-fx-text-fill: #8C8E8D; -fx-font-size: 9; -fx-font-weight: bold;"/>
                        <TextField fx:id="usernameField" promptText="Enter username" prefHeight="43"/>
                        <Label text="PASSWORD" style="-fx-text-fill: #8C8E8D; -fx-font-size: 9; -fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField" promptText="Enter password" prefHeight="43" onAction="#signIn"/>
                        <Label fx:id="errorLabel" wrapText="true" maxWidth="270" minHeight="32"/>
                        <Button fx:id="signInButton" text="Sign in to Velmora" onAction="#signIn" maxWidth="Infinity" prefHeight="44"/>
                        <Region prefHeight="4"/>
                        <Label text="DEMO ADMIN  admin / Admin123!" style="-fx-text-fill: #686B69; -fx-font-size: 9;"/>
                        <Label text="DEMO DRIVER  priya / Driver123!" style="-fx-text-fill: #686B69; -fx-font-size: 9;"/>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
