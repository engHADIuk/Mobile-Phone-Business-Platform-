<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="screen" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="velmora.controller.TrackController">

    <HBox styleClass="topbar" alignment="CENTER_LEFT">
        <Button text="← Dashboard" onAction="#goBack" styleClass="btn-back"/>
    </HBox>

    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="80" bottom="48" left="80"/></padding>

        <Label text="Order History" styleClass="page-title"/>
        <Label text="Track the status of everything you've ordered." styleClass="page-sub"/>

        <HBox spacing="10">
            <ToggleButton fx:id="filterAll" text="All" styleClass="storage-opt" onAction="#onFilterAll" selected="true"/>
            <ToggleButton fx:id="filterProcessing" text="Processing" styleClass="storage-opt" onAction="#onFilterProcessing"/>
            <ToggleButton fx:id="filterShipped" text="Shipped" styleClass="storage-opt" onAction="#onFilterShipped"/>
            <ToggleButton fx:id="filterDelivered" text="Delivered" styleClass="storage-opt" onAction="#onFilterDelivered"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="From:" styleClass="page-sub"/>
            <DatePicker fx:id="fromDatePicker" promptText="Any"/>
            <Label text="To:" styleClass="page-sub"/>
            <DatePicker fx:id="toDatePicker" promptText="Any"/>
            <Button text="Clear dates" onAction="#clearDateFilter" styleClass="btn-back"/>
        </HBox>

        <HBox spacing="24" VBox.vgrow="ALWAYS">
            <ListView fx:id="ordersListView" HBox.hgrow="ALWAYS" prefWidth="480"/>

            <VBox fx:id="detailPanel" spacing="10" styleClass="dash-card" prefWidth="340" minWidth="340">
                <Label fx:id="detailPlaceholder" text="Select an order to see its details." styleClass="page-sub" wrapText="true"/>

                <Label fx:id="detailId" text="" styleClass="dash-card-title" visible="false" managed="false"/>
                <Label fx:id="detailCustomer" text="" styleClass="page-sub" wrapText="true" visible="false" managed="false"/>
                <Label fx:id="detailSummary" text="" styleClass="page-sub" wrapText="true" visible="false" managed="false"/>
                <Label fx:id="detailDate" text="" styleClass="page-sub" visible="false" managed="false"/>
                <Label fx:id="detailTotal" text="" styleClass="product-price" visible="false" managed="false"/>
                <Label fx:id="detailStatus" text="" styleClass="dash-card-desc" visible="false" managed="false"/>
                <Label fx:id="detailShipping" text="" styleClass="page-sub" wrapText="true" visible="false" managed="false"/>
                <Label fx:id="detailCard" text="" styleClass="page-sub" visible="false" managed="false"/>

                <Label text="Items" styleClass="selector-title"/>
                <VBox fx:id="detailItemsBox" spacing="6"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
