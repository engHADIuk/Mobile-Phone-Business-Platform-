<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="screen" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="velmora.controller.ProductController">

    <HBox styleClass="topbar" alignment="CENTER_LEFT">
        <Button text="← Dashboard" onAction="#goBack" styleClass="btn-back"/>
    </HBox>

    <HBox styleClass="screen" VBox.vgrow="ALWAYS">

        <!-- LEFT: image placeholder panel (swap in an ImageView + real product photo later) -->
        <VBox styleClass="product-image-panel" alignment="CENTER" prefWidth="500" spacing="16">
            <Label text="📱" style="-fx-font-size: 120px;"/>
            <Label fx:id="stockTag" text="16 available now" styleClass="img-tag-stock"/>
        </VBox>

        <!-- RIGHT: details / configuration panel -->
        <VBox styleClass="product-details-panel" spacing="14" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding><Insets top="24" right="48" bottom="48" left="40"/></padding>

            <Label fx:id="productNameLabel" text="Velmora X1" styleClass="product-name"/>
            <Label fx:id="productDescLabel" text="The refined entry into flagship performance, crafted in a shadow-cut titanium frame."
                   styleClass="product-desc" wrapText="true" maxWidth="440"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="priceLabel" text="$$899" styleClass="product-price"/>
                <Label fx:id="oldPriceLabel" text="$$1,099" styleClass="price-old"/>
            </HBox>

            <Label text="Finish" styleClass="selector-title"/>
            <HBox spacing="10">
                <fx:define>
                    <ToggleGroup fx:id="colorGroup"/>
                </fx:define>
                <ToggleButton fx:id="colorBlack" text="Obsidian Black" toggleGroup="$colorGroup" selected="true" onAction="#selectColor" styleClass="color-opt"/>
                <ToggleButton fx:id="colorSilver" text="Titanium Silver" toggleGroup="$colorGroup" onAction="#selectColor" styleClass="color-opt"/>
                <ToggleButton fx:id="colorBlue" text="Midnight Blue" toggleGroup="$colorGroup" onAction="#selectColor" styleClass="color-opt"/>
            </HBox>

            <Label text="Storage" styleClass="selector-title"/>
            <HBox spacing="10">
                <fx:define>
                    <ToggleGroup fx:id="storageGroup"/>
                </fx:define>
                <ToggleButton fx:id="storage128" text="128GB" toggleGroup="$storageGroup" selected="true" onAction="#selectStorage" styleClass="storage-opt"/>
                <ToggleButton fx:id="storage256" text="256GB" toggleGroup="$storageGroup" onAction="#selectStorage" styleClass="storage-opt"/>
                <ToggleButton fx:id="storage512" text="512GB" toggleGroup="$storageGroup" onAction="#selectStorage" styleClass="storage-opt"/>
            </HBox>

            <Label text="Quantity" styleClass="selector-title"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="−" onAction="#decreaseQty" styleClass="qty-btn"/>
                <Label fx:id="qtyLabel" text="1" styleClass="qty-num"/>
                <Button text="+" onAction="#increaseQty" styleClass="qty-btn"/>
            </HBox>
            <Label fx:id="qtyError" text="Quantity exceeds available stock" styleClass="error-text" visible="false" managed="false"/>

            <HBox spacing="12">
                <Button text="Add to Cart" onAction="#addToCart" styleClass="btn-add-cart"/>
                <Button text="Buy Now" onAction="#buyNow" styleClass="btn-buy-now"/>
            </HBox>

            <Label text="🚚 Free next-day delivery on orders over $500" styleClass="delivery-note"/>
        </VBox>
    </HBox>
</VBox>
