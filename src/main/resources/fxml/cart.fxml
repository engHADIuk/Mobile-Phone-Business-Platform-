<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="screen" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="velmora.controller.CartController">

    <HBox styleClass="topbar" alignment="CENTER_LEFT">
        <Button text="← Dashboard" onAction="#goBack" styleClass="btn-back"/>
    </HBox>

    <VBox spacing="18" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="80" bottom="48" left="80"/></padding>

        <Label text="Your Cart" styleClass="page-title"/>

        <ListView fx:id="cartListView" prefHeight="180"/>

        <VBox spacing="6" alignment="CENTER_RIGHT">
            <HBox spacing="12">
                <Label text="Subtotal:" styleClass="page-sub"/>
                <Label fx:id="subtotalLabel" text="$$0" styleClass="cart-item-price"/>
            </HBox>
            <HBox spacing="12">
                <Label text="Shipping:" styleClass="page-sub"/>
                <Label fx:id="shippingLabel" text="$$0" styleClass="cart-item-price"/>
            </HBox>
            <HBox spacing="12">
                <Label text="Total:" styleClass="page-title"/>
                <Label fx:id="totalLabel" text="$$0" styleClass="page-title"/>
            </HBox>
        </VBox>

        <VBox fx:id="checkoutForm" spacing="14" visible="false" managed="false">
            <Label text="Shipping Address" styleClass="selector-title"/>
            <TextField fx:id="shippingAddressField" promptText="Street address, city, postcode"/>

            <Label text="Payment (demo — no real transaction is made)" styleClass="selector-title"/>
            <HBox spacing="12">
                <TextField fx:id="cardNumberField" promptText="Card number" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="cardExpiryField" promptText="MM/YY" prefWidth="90"/>
                <PasswordField fx:id="cardCvvField" promptText="CVV" prefWidth="80"/>
            </HBox>

            <Label text="Confirm Identity" styleClass="selector-title"/>
            <HBox spacing="12">
                <TextField fx:id="confirmEmailField" promptText="Email" HBox.hgrow="ALWAYS"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Password" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <Label fx:id="orderError" text="" styleClass="error-text" visible="false" managed="false" wrapText="true"/>

        <Button fx:id="confirmButton" text="Confirm Order" onAction="#confirmOrder" styleClass="btn-add-cart"/>
    </VBox>
</VBox>
